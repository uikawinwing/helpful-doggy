# Discord bot token. Never put this in the SillyTavern extension.
DISCORD_BOT_TOKEN=

# Only messages and slash commands from this guild are accepted.
TARGET_GUILD_ID=

# Comma-separated Forum/Channel IDs.
# Threads whose parent Forum is listed here are allowed.
ALLOWED_CHANNEL_IDS=

# Bridge network settings.
# 0.0.0.0 allows another device on the same LAN to reach the bridge.
HOST=0.0.0.0
PORT=3210

# Maximum JSON attachment size the bridge will download (bytes).
MAX_ATTACHMENT_BYTES=5242880

# Local persistent release registry.
RELEASE_STORE_PATH=./data/releases.json
