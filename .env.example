# Discord bot token. Never put this in the SillyTavern extension.
DISCORD_BOT_TOKEN=

# Only messages from this guild are accepted.
TARGET_GUILD_ID=

# Comma-separated forum/channel IDs.
# A message is accepted when its channel ID OR its thread parent ID is listed here.
ALLOWED_CHANNEL_IDS=

PORT=3210
MAX_ATTACHMENT_BYTES=5242880
